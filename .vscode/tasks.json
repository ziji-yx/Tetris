{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build Tetris",
      "type": "process",
      "command": "gcc",
      "args": [
        "${workspaceFolder}/Tetris.demo.c",
        "-std=c17",
        "-O2",
        "-Wall",
        "-Wextra",
        "-I",
        "C:\\raylib\\raylib\\src",
        "-L",
        "C:\\raylib\\raylib\\src",
        "-lraylib",
        "-lopengl32",
        "-lgdi32",
        "-lwinmm",
        "-o",
        "${workspaceFolder}/Tetris.demo.exe"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": ["$gcc"]
    }
  ]
}
